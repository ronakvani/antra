# Antra Builder Authentication Configuration
# Set your Supabase project URL and anon public key here.
# When provided, user login and signup will automatically sync with your remote Supabase instance.
# If omitted or left as default, Antra gracefully falls back to persistent client-side storage.

VITE_SUPABASE_URL=your-supabase-url
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Antra Remotion AI Engine (OpenRouter API Key)
# Get a free key at https://openrouter.ai/keys
VITE_OPENROUTER_API_KEY=your-openrouter-api-key

# Razorpay Payment Gateway Configuration
# Required for generating live UPI QR codes and verifying payment status
# Get keys from Razorpay Dashboard -> Settings -> API Keys
VITE_RAZORPAY_KEY_ID=your_razorpay_key_id
VITE_RAZORPAY_KEY_SECRET=your_razorpay_key_secret
